#:kivy 2.3.1

# AlertCom - Pantalla 4: Formulario de reporte
# Lógica de esta pantalla: views/pantallas/report_view.py

<ReportScreen>:
    md_bg_color: app.theme_cls.surfaceColor

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.navegacion.volver()

            MDTopAppBarTitle:
                text: "Nuevo Reporte"
                pos_hint: {"center_x": 0.5}

        ScrollView:
            do_scroll_x: False
            bar_width: "4dp"

            MDBoxLayout:
                orientation: "vertical"
                spacing: "18dp"
                padding: ["24dp", "20dp", "24dp", "30dp"]
                adaptive_height: True

                # ── CAMPO 1: Foto ──
                MDLabel:
                    text: "Fotografía del daño"
                    font_style: "Title"
                    role: "small"
                    theme_text_color: "Primary"
                    adaptive_height: True

                MDCard:
                    size_hint_y: None
                    height: "140dp"
                    theme_bg_color: "Custom"
                    md_bg_color: [0.15, 0.15, 0.18, 1]
                    padding: "16dp"
                    on_release: root.simular_foto()

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "8dp"
                        adaptive_height: True
                        pos_hint: {"center_y": 0.5}

                        MDIcon:
                            icon: "camera-plus-outline"
                            font_size: "48sp"
                            pos_hint: {"center_x": 0.5}
                            theme_text_color: "Custom"
                            text_color: [1, 0.6, 0, 1]
                            adaptive_height: True

                        MDLabel:
                            id: photo_label
                            text: "Toca para tomar o seleccionar una foto"
                            font_style: "Body"
                            role: "medium"
                            halign: "center"
                            theme_text_color: "Secondary"
                            adaptive_height: True

                MDLabel:
                    text: "La ubicación GPS se adjuntará automáticamente"
                    font_style: "Label"
                    role: "large"
                    theme_text_color: "Custom"
                    text_color: [0.5, 0.7, 0.5, 1]
                    adaptive_height: True

                MDDivider:

                # ── CAMPO 2: Tipo de daño ──
                MDLabel:
                    text: "Tipo de daño"
                    font_style: "Title"
                    role: "small"
                    theme_text_color: "Primary"
                    adaptive_height: True

                MDButton:
                    id: type_selector
                    style: "outlined"
                    theme_width: "Custom"
                    size_hint_x: 1
                    on_release: root.abrir_menu_tipo()

                    MDButtonIcon:
                        icon: "road-variant"

                    MDButtonText:
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        id: type_label
                        text: "Seleccionar tipo"

                # ── CAMPO 3: Gravedad ──
                MDLabel:
                    text: "Gravedad"
                    font_style: "Title"
                    role: "small"
                    theme_text_color: "Primary"
                    adaptive_height: True

                MDButton:
                    id: severity_selector
                    style: "outlined"
                    theme_width: "Custom"
                    size_hint_x: 1
                    on_release: root.abrir_menu_gravedad()

                    MDButtonIcon:
                        icon: "alert-circle-outline"

                    MDButtonText:
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        id: severity_label
                        text: "Seleccionar gravedad"

                MDDivider:

                # ── CAMPO 4: Descripción ──
                MDLabel:
                    text: "Descripción (opcional)"
                    font_style: "Title"
                    role: "small"
                    theme_text_color: "Primary"
                    adaptive_height: True

                MDTextField:
                    id: description_field
                    mode: "outlined"
                    multiline: True

                    MDTextFieldHintText:
                        text: "Describe brevemente el daño vial..."

                    MDTextFieldHelperText:
                        text: "Ej: Bache grande en calle Alemania frente al N°450"
                        mode: "on_focus"

                    MDTextFieldMaxLengthText:
                        max_text_length: 250

                Widget:
                    size_hint_y: None
                    height: "10dp"

                MDButton:
                    style: "filled"
                    theme_width: "Custom"
                    size_hint_x: 1
                    on_release: root.enviar_reporte()

                    MDButtonIcon:
                        icon: "send"

                    MDButtonText:
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        text: "Enviar Reporte"
                        font_style: "Title"
