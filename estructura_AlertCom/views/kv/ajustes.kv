#:kivy 2.3.1

# AlertCom - Pantalla: Ajustes (apariencia y gestor de cuenta)
# Lógica de esta pantalla: views/pantallas/ajustes_view.py


# --- Muestra de color de fondo (círculo + nombre) ---
<MuestraFondo@ButtonBehavior+MDBoxLayout>:
    clave: ""
    texto: ""
    color: [0, 0, 0, 1]
    seleccionada: False
    orientation: "vertical"
    spacing: "6dp"
    size_hint: None, None
    # Alto según el texto ("Azul noche" puede ocupar dos líneas)
    size: dp(66), self.minimum_height

    Widget:
        size_hint_y: None
        height: "50dp"
        canvas:
            Color:
                rgba: root.color
            Ellipse:
                pos: self.center_x - dp(22), self.center_y - dp(22)
                size: dp(44), dp(44)
            Color:
                rgba: (1, 0.6, 0, 1) if root.seleccionada else (1, 1, 1, 0.25)
            Line:
                circle: (self.center_x, self.center_y, dp(24) if root.seleccionada else dp(22))
                width: dp(2.2) if root.seleccionada else dp(1)

    MDLabel:
        text: root.texto
        font_style: "Label"
        role: "medium"
        theme_font_size: "Custom"
        font_size: min(sp(12) * app.factor_letra, dp(13))
        adaptive_height: True
        bold: root.seleccionada
        halign: "center"
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 1) if root.seleccionada else (1, 1, 1, 0.65)


# --- Fila del gestor de cuenta: ícono, título, detalle y flecha ---
<OpcionCuenta@ButtonBehavior+MDBoxLayout>:
    icono: "account"
    titulo: ""
    detalle: ""
    color: [1, 0.6, 0, 1]
    adaptive_height: True
    spacing: "14dp"
    padding: ["8dp", "10dp", "4dp", "10dp"]
    canvas.before:
        Color:
            rgba: (1, 1, 1, 0.07) if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

    MDBoxLayout:
        size_hint: None, None
        size: "40dp", "40dp"
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: (list(root.color[:3]) + [0.16]) if len(root.color) >= 3 else (0, 0, 0, 0)
            Ellipse:
                pos: self.pos
                size: self.size

        MDIcon:
            icon: root.icono
            theme_text_color: "Custom"
            text_color: root.color
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            halign: "center"

    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        pos_hint: {"center_y": 0.5}

        MDLabel:
            text: root.titulo
            font_style: "Title"
            role: "small"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: root.color if len(root.color) >= 3 and root.color[0] > 0.85 and root.color[1] < 0.4 else (1, 1, 1, 1)

        MDLabel:
            text: root.detalle
            font_style: "Body"
            role: "small"
            adaptive_height: True
            theme_text_color: "Secondary"

    MDIcon:
        icon: "chevron-right"
        theme_text_color: "Secondary"
        pos_hint: {"center_y": 0.5}
        size_hint_x: None
        width: "24dp"


# --- Tarjeta de sección ---
<TarjetaAjustes@MDBoxLayout>:
    orientation: "vertical"
    adaptive_height: True
    spacing: "12dp"
    padding: "16dp"
    canvas.before:
        Color:
            rgba: 0.15, 0.15, 0.2, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20)]


<TituloSeccion@MDBoxLayout>:
    icono: ""
    texto: ""
    adaptive_height: True
    spacing: "8dp"
    padding: ["4dp", "6dp", "0dp", "0dp"]

    MDIcon:
        icon: root.icono
        theme_text_color: "Custom"
        text_color: [1, 0.6, 0, 1]
        pos_hint: {"center_y": 0.5}
        size_hint: None, None
        size: self.texture_size

    MDLabel:
        text: root.texto
        font_style: "Title"
        role: "medium"
        bold: True
        adaptive_height: True
        pos_hint: {"center_y": 0.5}


<AjustesScreen>:
    theme_bg_color: "Custom"
    md_bg_color: app.color_fondo

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            theme_bg_color: "Custom"
            md_bg_color: app.color_fondo
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.navegacion.ir_a("profile", "right")

            MDTopAppBarTitle:
                text: "Ajustes"
                pos_hint: {"center_x": 0.5}

        ScrollView:
            do_scroll_x: False
            bar_width: "4dp"

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: "14dp"
                padding: ["16dp", "8dp", "16dp", "28dp"]

                # ───────────── APARIENCIA ─────────────
                TituloSeccion:
                    icono: "palette-outline"
                    texto: "Apariencia"

                TarjetaAjustes:

                    MDLabel:
                        text: "Tamaño de letra"
                        font_style: "Title"
                        role: "small"
                        adaptive_height: True

                    MDStackLayout:
                        id: grupo_letra
                        adaptive_height: True
                        spacing: "8dp"

                    # Vista previa con el tamaño elegido
                    MDBoxLayout:
                        adaptive_height: True
                        padding: "14dp"
                        spacing: "10dp"
                        canvas.before:
                            Color:
                                rgba: 0, 0, 0, 0.25
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]

                        MDIcon:
                            icon: "format-size"
                            theme_text_color: "Custom"
                            text_color: [1, 0.6, 0, 1]
                            pos_hint: {"center_y": 0.5}
                            size_hint: None, None
                            size: self.texture_size

                        MDLabel:
                            text: "Vista previa: así se leerán los textos de AlertCom."
                            font_style: "Body"
                            role: "large"
                            adaptive_height: True
                            pos_hint: {"center_y": 0.5}

                    MDDivider:

                    MDLabel:
                        text: "Fondo de la app"
                        font_style: "Title"
                        role: "small"
                        adaptive_height: True

                    MDStackLayout:
                        id: grupo_fondo
                        adaptive_height: True
                        spacing: "6dp"

                # ───────────── MI CUENTA ─────────────
                TituloSeccion:
                    icono: "account-cog-outline"
                    texto: "Mi cuenta"

                TarjetaAjustes:

                    # Avatar con la inicial + nombre y correo
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: "14dp"

                        MDBoxLayout:
                            size_hint: None, None
                            size: "56dp", "56dp"
                            canvas.before:
                                Color:
                                    rgba: 1, 0.6, 0, 1
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                            MDLabel:
                                id: inicial
                                text: "A"
                                font_style: "Headline"
                                role: "small"
                                bold: True
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: [0.1, 0.08, 0.06, 1]

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: nombre_cuenta
                                text: ""
                                font_style: "Title"
                                role: "medium"
                                bold: True
                                adaptive_height: True

                            MDLabel:
                                id: correo_cuenta
                                text: ""
                                font_style: "Body"
                                role: "medium"
                                adaptive_height: True
                                theme_text_color: "Secondary"

                            MDLabel:
                                id: rol_cuenta
                                text: ""
                                font_style: "Label"
                                role: "medium"
                                adaptive_height: True
                                theme_text_color: "Custom"
                                text_color: [1, 0.6, 0, 1]

                    MDDivider:

                    OpcionCuenta:
                        icono: "account-edit-outline"
                        titulo: "Cambiar nombre"
                        detalle: "Cómo te verá la app"
                        on_release: root.cambiar_nombre()

                    OpcionCuenta:
                        icono: "email-edit-outline"
                        titulo: "Cambiar correo"
                        detalle: "Con el que inicias sesión"
                        on_release: root.cambiar_correo()

                    OpcionCuenta:
                        icono: "lock-reset"
                        titulo: "Cambiar contraseña"
                        detalle: "Te pediremos la actual"
                        on_release: root.cambiar_contrasena()

                TarjetaAjustes:

                    OpcionCuenta:
                        icono: "account-remove-outline"
                        titulo: "Eliminar cuenta"
                        detalle: "Tus reportes se conservan sin tu nombre"
                        color: [0.9, 0.28, 0.28, 1]
                        on_release: root.eliminar_cuenta()
