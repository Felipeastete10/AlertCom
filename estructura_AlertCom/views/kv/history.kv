#:kivy 2.3.1

# AlertCom - Pantalla 5: Historial de reportes
# Lógica de esta pantalla: views/pantallas/history_view.py

# Contador que también es filtro: al tocarlo, la lista muestra solo ese estado.
<TarjetaFiltro@ButtonBehavior+MDBoxLayout>:
    text: "0"
    texto: ""
    color: [1, 0.6, 0, 1]
    activa: False
    orientation: "vertical"
    padding: ["4dp", "8dp", "4dp", "6dp"]
    canvas.before:
        Color:
            rgba: (self.color[0], self.color[1], self.color[2], 0.16) if self.activa else (0.15, 0.15, 0.2, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: self.color if self.activa else (1, 1, 1, 0.06)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(14))
            width: dp(1.4) if self.activa else dp(1)

    # Tamaños con tope: la tarjeta es angosta (4 por fila)
    MDLabel:
        text: root.text
        font_style: "Headline"
        role: "small"
        theme_font_size: "Custom"
        font_size: min(sp(24) * app.factor_letra, dp(26))
        bold: True
        halign: "center"
        theme_text_color: "Custom"
        text_color: root.color

    MDLabel:
        text: root.texto
        font_style: "Label"
        role: "small"
        theme_font_size: "Custom"
        font_size: min(sp(11) * app.factor_letra, dp(12))
        shorten: True
        shorten_from: "right"
        halign: "center"
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 0.95) if root.activa else (1, 1, 1, 0.6)


# Barra de avance del reporte: Recibido → En revisión → Reparado
<PasosEstado@Widget>:
    paso: 0
    color: [1, 1, 1, 1]
    size_hint_y: None
    height: "12dp"
    canvas:
        Color:
            rgba: self.color if self.paso >= 1 else (1, 1, 1, 0.15)
        Line:
            points: [self.x + dp(5), self.center_y, self.center_x, self.center_y]
            width: dp(1.6)
        Color:
            rgba: self.color if self.paso >= 2 else (1, 1, 1, 0.15)
        Line:
            points: [self.center_x, self.center_y, self.right - dp(5), self.center_y]
            width: dp(1.6)
        Color:
            rgba: self.color
        Ellipse:
            pos: self.x, self.center_y - dp(5)
            size: dp(10), dp(10)
        Color:
            rgba: self.color if self.paso >= 1 else (0.3, 0.3, 0.35, 1)
        Ellipse:
            pos: self.center_x - dp(5), self.center_y - dp(5)
            size: dp(10), dp(10)
        Color:
            rgba: self.color if self.paso >= 2 else (0.3, 0.3, 0.35, 1)
        Ellipse:
            pos: self.right - dp(10), self.center_y - dp(5)
            size: dp(10), dp(10)


# Tarjeta de un reporte: franja del color del estado, foto (o ícono del tipo),
# título, estado, calle, gravedad, hace cuánto y la barra de avance.
# El alto se ajusta al contenido: con letra grande la tarjeta crece en vez
# de cortar o encimar los textos.
<TextoTarjeta@MDLabel>:
    adaptive_height: True
    shorten: True
    shorten_from: "right"
    pos_hint: {"center_y": 0.5}

<TarjetaReporte@ButtonBehavior+MDBoxLayout>:
    titulo: ""
    calle: ""
    gravedad: ""
    icono_gravedad: "gauge"
    color_gravedad: [1, 0.6, 0, 1]
    estado: ""
    icono_estado: "alert-circle"
    color_estado: [1, 0.6, 0, 1]
    icono_tipo: "road-variant"
    paso: 0
    fecha: ""
    foto: ""
    por_eliminar: False
    size_hint_y: None
    height: max(dp(146), datos.minimum_height + dp(24))
    padding: ["16dp", "12dp", "14dp", "12dp"]
    spacing: "12dp"
    canvas.before:
        Color:
            rgba: (0.19, 0.19, 0.25, 1) if self.state == "down" else (0.15, 0.15, 0.2, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
        Color:
            rgba: self.color_estado
        RoundedRectangle:
            pos: self.pos
            size: dp(6), self.height
            radius: [dp(18), 0, 0, dp(18)]

    # Foto del daño (o el ícono del tipo si no tiene foto)
    MDRelativeLayout:
        size_hint_x: None
        width: "84dp"
        canvas.before:
            Color:
                rgba: 0.1, 0.1, 0.13, 1
            RoundedRectangle:
                pos: 0, 0
                size: self.size
                radius: [dp(14)]

        MDIcon:
            icon: root.icono_tipo
            theme_font_size: "Custom"
            font_size: "38dp"
            theme_text_color: "Custom"
            text_color: [1, 0.6, 0, 0.85]
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            halign: "center"
            opacity: 0 if root.foto else 1

        Image:
            source: root.foto
            fit_mode: "cover"
            opacity: 1 if root.foto else 0

    MDBoxLayout:
        id: datos
        orientation: "vertical"
        spacing: "5dp"
        adaptive_height: True
        pos_hint: {"center_y": 0.5}

        # Título (ocupa todo el ancho; si no cabe termina en "…")
        TextoTarjeta:
            text: root.titulo
            font_style: "Title"
            role: "medium"
            bold: True

        # Estado: pastilla de color con ícono
        MDBoxLayout:
            adaptive_size: True
            spacing: "4dp"
            padding: ["8dp", "3dp", "10dp", "3dp"]
            canvas.before:
                Color:
                    rgba: (list(root.color_estado[:3]) + [0.18]) if len(root.color_estado) >= 3 else (0, 0, 0, 0)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [self.height / 2]

            MDIcon:
                icon: root.icono_estado
                theme_font_size: "Custom"
                font_size: "14dp"
                theme_text_color: "Custom"
                text_color: root.color_estado
                size_hint: None, None
                size: self.texture_size
                pos_hint: {"center_y": 0.5}

            MDLabel:
                text: root.estado
                font_style: "Label"
                role: "medium"
                bold: True
                adaptive_size: True
                theme_text_color: "Custom"
                text_color: root.color_estado
                pos_hint: {"center_y": 0.5}

        # Calle
        MDBoxLayout:
            adaptive_height: True
            spacing: "4dp"

            MDIcon:
                icon: "map-marker-outline"
                theme_font_size: "Custom"
                font_size: "16dp"
                theme_text_color: "Secondary"
                size_hint: None, None
                size: self.texture_size
                pos_hint: {"center_y": 0.5}

            TextoTarjeta:
                text: root.calle
                font_style: "Body"
                role: "medium"
                theme_text_color: "Secondary"

        # Gravedad
        MDBoxLayout:
            adaptive_height: True
            spacing: "4dp"

            MDIcon:
                icon: root.icono_gravedad
                theme_font_size: "Custom"
                font_size: "16dp"
                theme_text_color: "Custom"
                text_color: root.color_gravedad
                size_hint: None, None
                size: self.texture_size
                pos_hint: {"center_y": 0.5}

            TextoTarjeta:
                text: root.gravedad
                font_style: "Label"
                role: "large"
                bold: True
                theme_text_color: "Custom"
                text_color: root.color_gravedad

        # Hace cuánto se envió, o "Por eliminar" si hay una solicitud
        MDBoxLayout:
            adaptive_height: True
            spacing: "4dp"

            MDIcon:
                icon: "delete-clock-outline" if root.por_eliminar else "clock-outline"
                theme_font_size: "Custom"
                font_size: "14dp"
                theme_text_color: "Custom"
                text_color: [1, 0.5, 0.47, 1] if root.por_eliminar else [1, 1, 1, 0.6]
                size_hint: None, None
                size: self.texture_size
                pos_hint: {"center_y": 0.5}

            TextoTarjeta:
                text: "Por eliminar" if root.por_eliminar else root.fecha
                font_style: "Label"
                role: "medium"
                bold: root.por_eliminar
                theme_text_color: "Custom"
                text_color: [1, 0.5, 0.47, 1] if root.por_eliminar else [1, 1, 1, 0.6]

        Widget:
            size_hint_y: None
            height: "2dp"

        PasosEstado:
            paso: root.paso
            color: root.color_estado

        # Nombres de los pasos: con tope para que cada uno quepa en su tercio
        MDBoxLayout:
            adaptive_height: True

            TextoTarjeta:
                text: "Recibido"
                font_style: "Label"
                role: "small"
                theme_font_size: "Custom"
                font_size: min(sp(11) * app.factor_letra, dp(11.5))
                theme_text_color: "Secondary"

            TextoTarjeta:
                text: "En revisión"
                font_style: "Label"
                role: "small"
                theme_font_size: "Custom"
                font_size: min(sp(11) * app.factor_letra, dp(11.5))
                halign: "center"
                theme_text_color: "Secondary"

            TextoTarjeta:
                text: "Reparado"
                font_style: "Label"
                role: "small"
                theme_font_size: "Custom"
                font_size: min(sp(11) * app.factor_letra, dp(11.5))
                halign: "right"
                theme_text_color: "Secondary"


# Aviso para el funcionario: hay solicitudes de eliminación por revisar.
# Aviso para el funcionario (solicitudes de eliminación o reportes por
# confirmar). Cada uso elige su ícono y su color.
<AvisoSolicitudes@ButtonBehavior+MDBoxLayout>:
    texto: ""
    activo: False
    icono: "delete-clock-outline"
    color: [0.9, 0.28, 0.28]
    color_icono: [1, 0.5, 0.47, 1]
    color_texto: [1, 0.78, 0.76, 1]
    spacing: "10dp"
    padding: ["14dp", "10dp", "12dp", "10dp"]
    canvas.before:
        Color:
            rgba: (list(self.color[:3]) + [0.26 if self.activo else 0.15]) if len(self.color) >= 3 else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: (list(self.color[:3]) + [1 if self.activo else 0.5]) if len(self.color) >= 3 else (0, 0, 0, 0)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))
            width: dp(1.3)

    MDIcon:
        icon: root.icono
        theme_text_color: "Custom"
        text_color: root.color_icono
        size_hint: None, None
        size: self.texture_size
        pos_hint: {"center_y": 0.5}

    MDLabel:
        text: root.texto
        font_style: "Label"
        role: "large"
        bold: True
        theme_text_color: "Custom"
        text_color: root.color_texto
        pos_hint: {"center_y": 0.5}

    MDIcon:
        icon: "close" if root.activo else "chevron-right"
        theme_text_color: "Custom"
        text_color: root.color_texto
        size_hint: None, None
        size: self.texture_size
        pos_hint: {"center_y": 0.5}


<HistoryScreen>:
    theme_bg_color: "Custom"
    md_bg_color: app.color_fondo

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:

            theme_bg_color: "Custom"

            md_bg_color: app.color_fondo
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.navegacion.volver()

            MDTopAppBarTitle:
                id: titulo_historial
                text: "Mis Reportes"
                pos_hint: {"center_x": 0.5}

        # Solo lo ve el funcionario: reportes nuevos que esperan su revisión
        MDBoxLayout:
            id: caja_confirmar
            size_hint_y: None
            height: 0
            opacity: 0
            padding: ["12dp", "10dp", "12dp", "0dp"]

            AvisoSolicitudes:
                id: aviso_confirmar
                icono: "shield-search"
                color: [0.55, 0.6, 1]
                color_icono: [0.67, 0.72, 1, 1]
                color_texto: [0.84, 0.86, 1, 1]
                on_release: app.navegacion.ir_a("confirmar", "left")

        # Solo lo ve el funcionario, y solo si hay solicitudes
        MDBoxLayout:
            id: caja_solicitudes
            size_hint_y: None
            height: 0
            opacity: 0
            padding: ["12dp", "10dp", "12dp", "0dp"]

            AvisoSolicitudes:
                id: aviso_solicitudes
                on_release: root.filtrar("eliminacion")

        # Solo vecinos: sus reportes, o los ya confirmados de toda la ciudad
        MDBoxLayout:
            id: caja_pestanas
            size_hint_y: None
            height: 0
            opacity: 0
            spacing: "8dp"
            padding: ["12dp", "10dp", "12dp", "0dp"]

            Pastilla:
                id: pestana_mios
                texto: "Mis reportes"
                icono: "account-outline"
                on_release: root.cambiar_vista("mios")

            Pastilla:
                id: pestana_confirmados
                texto: "Confirmados"
                icono: "check-decagram-outline"
                color: [0.2, 0.66, 0.33, 1]
                on_release: root.cambiar_vista("confirmados")

        # ── Contadores = filtros (se llenan desde history_view.py) ──
        MDBoxLayout:
            spacing: "8dp"
            padding: ["12dp", "12dp", "12dp", "4dp"]
            size_hint_y: None
            height: "88dp"

            TarjetaFiltro:
                id: filtro_todos
                texto: "Total"
                color: [1, 0.6, 0, 1]
                activa: True
                on_release: root.filtrar(None)

            TarjetaFiltro:
                id: filtro_pendiente
                texto: "Pendientes"
                color: [0.9, 0.28, 0.28, 1]
                on_release: root.filtrar("Pendiente")

            TarjetaFiltro:
                id: filtro_revision
                texto: "En revisión"
                color: [0.96, 0.62, 0.04, 1]
                on_release: root.filtrar("En revisión")

            TarjetaFiltro:
                id: filtro_reparado
                texto: "Reparados"
                color: [0.2, 0.66, 0.33, 1]
                on_release: root.filtrar("Reparado")

        # Filtro por gravedad (views/componentes/filtros.py); se desliza si no cabe
        ScrollView:
            do_scroll_y: False
            size_hint_y: None
            height: "44dp"
            bar_width: 0

            MDBoxLayout:
                id: filtro_gravedad
                adaptive_width: True
                spacing: "6dp"
                padding: ["12dp", "4dp", "12dp", "4dp"]

        MDLabel:
            id: texto_filtro
            text: "Toca un contador para filtrar la lista"
            font_style: "Label"
            role: "medium"
            theme_text_color: "Secondary"
            adaptive_height: True
            padding: ["16dp", "2dp", "16dp", "8dp"]

        MDDivider:

        # ── Lista de reportes (se llena desde history_view.py) ──
        ScrollView:
            do_scroll_x: False

            MDList:
                id: lista_reportes
                spacing: "10dp"
                padding: ["12dp", "8dp", "12dp", "12dp"]

        MDBoxLayout:
            size_hint_y: None
            height: "70dp"
            padding: ["20dp", "8dp", "20dp", "8dp"]

            MDButton:
                style: "outlined"
                theme_width: "Custom"
                size_hint_x: 1
                on_release: app.navegacion.volver()

                MDButtonIcon:
                    icon: "home"

                MDButtonText:
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    text: "Volver al Inicio"
