#:kivy 2.3.1

# AlertCom - Pantalla 3: Mapa (Home)
# Lógica de esta pantalla: views/pantallas/home_view.py

<HomeScreen>:
    theme_bg_color: "Custom"
    md_bg_color: app.color_fondo

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:

            theme_bg_color: "Custom"

            md_bg_color: app.color_fondo
            type: "small"

            MDTopAppBarTitle:
                text: "AlertCom"
                pos_hint: {"center_x": 0.5}

            MDTopAppBarTrailingButtonContainer:
                # Solo funcionario: lleva a "Confirmar reportes" (home_view.py)
                MDActionTopAppBarButton:
                    id: boton_confirmar
                    icon: "shield-check-outline"
                    opacity: 0
                    disabled: True
                    on_release: app.navegacion.ir_a("confirmar", "left")

                MDActionTopAppBarButton:
                    icon: "account-circle-outline"
                    on_release: app.navegacion.ir_a("profile", "left")

        # ── Zona del mapa. Orden de dibujo: lo primero queda abajo. ──
        MDFloatLayout:
            id: map_container

            # Simulación (se elimina si kivy_garden.mapview está instalado)
            MDBoxLayout:
                id: simulacion_mapa
                orientation: "vertical"
                spacing: "8dp"
                padding: ["20dp", "70dp", "20dp", "110dp"]

                MDIcon:
                    icon: "map-outline"
                    font_size: "110sp"
                    pos_hint: {"center_x": 0.5}
                    theme_text_color: "Custom"
                    text_color: [0.4, 0.6, 0.4, 0.5]
                    size_hint_y: None
                    height: "130dp"

                MDLabel:
                    text: "Mapa de Temuco"
                    font_style: "Title"
                    role: "large"
                    halign: "center"
                    theme_text_color: "Secondary"
                    adaptive_height: True

                MDLabel:
                    text: "Instala kivy_garden.mapview para ver el mapa real"
                    font_style: "Body"
                    role: "medium"
                    halign: "center"
                    theme_text_color: "Secondary"
                    adaptive_height: True

                Widget:

            # Banner con texto remoto (Sesión 22)
            MDCard:
                size_hint: 0.94, None
                height: "56dp"
                pos_hint: {"center_x": 0.5, "top": 0.98}
                padding: ["12dp", "8dp"]
                spacing: "10dp"
                theme_bg_color: "Custom"
                md_bg_color: [0.12, 0.12, 0.15, 0.92]

                MDIcon:
                    icon: "bullhorn-outline"
                    theme_text_color: "Custom"
                    text_color: [1, 0.6, 0, 1]
                    pos_hint: {"center_y": 0.5}

                MDLabel:
                    text: app.mensaje_banner
                    font_style: "Body"
                    role: "medium"
                    theme_text_color: "Custom"
                    text_color: [1, 1, 1, 1]
                    shorten: True
                    shorten_from: "right"

            # Leyenda = filtros: tocar un estado muestra u oculta sus marcadores
            MDBoxLayout:
                id: filtros_estado
                adaptive_size: True
                spacing: "6dp"
                padding: "6dp"
                pos_hint: {"center_x": 0.5, "y": 0.19}
                canvas.before:
                    Color:
                        rgba: 0.12, 0.12, 0.15, 0.88
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [self.height / 2]

            # Crédito obligatorio de la licencia de OpenStreetMap
            MDLabel:
                text: "© OpenStreetMap"
                font_style: "Label"
                role: "small"
                # Tamaño fijo: el crédito del mapa no crece con la letra
                theme_font_size: "Custom"
                font_size: "10dp"
                theme_text_color: "Custom"
                text_color: [1, 1, 1, 0.7]
                halign: "right"
                size_hint: None, None
                size: "140dp", "20dp"
                pos_hint: {"right": 0.98, "y": 0.005}

            # Centrar el mapa en la ubicación actual (GPS del teléfono)
            MDIconButton:
                icon: "crosshairs-gps"
                style: "filled"
                pos_hint: {"right": 0.96, "y": 0.29}
                on_release: root.centrar_en_mi_ubicacion()

            # Botón principal (texto configurable remotamente)
            MDExtendedFabButton:
                style: "large"
                fab_state: "expand"
                pos_hint: {"center_x": 0.5, "y": 0.04}
                on_release: root.ir_a_reporte()

                MDExtendedFabButtonIcon:
                    icon: "plus"

                # Tamaño fijo: el botón no cambia de ancho con el tamaño de letra
                MDExtendedFabButtonText:
                    text: app.texto_boton_reporte
                    theme_font_size: "Custom"
                    font_size: "16sp"

        MDNavigationBar:
            id: barra_navegacion
            on_switch_tabs: app.navegacion.al_cambiar_pestana(*args)

            MDNavigationItem:
                id: item_inicio
                active: True
                MDNavigationItemIcon:
                    icon: "home"
                MDNavigationItemLabel:
                    text: "Inicio"

            MDNavigationItem:
                MDNavigationItemIcon:
                    icon: "clipboard-text-clock-outline"
                MDNavigationItemLabel:
                    text: "Mis Reportes"

            MDNavigationItem:
                MDNavigationItemIcon:
                    icon: "account-outline"
                MDNavigationItemLabel:
                    text: "Perfil"
