# Entornos virtuales (no se suben: cada integrante crea el suyo)
entorno_alertcom/
myenv/
venv/
env/
.venv/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Datos locales de la app (usuarios con hashes, reportes, logs)
estructura_AlertCom/datos/
*.log
*.tmp

# Caché de tiles del mapa (kivy_garden.mapview)
cache/

# VS Code (se comparte solo la configuración del depurador)
.vscode/*
!.vscode/launch.json

# Archivos del sistema
.DS_Store
Thumbs.db

# Buildozer (APK): descargas del SDK y archivos compilados
.buildozer/
bin/

# Analítica: los eventos crudos no se suben (son datos de uso de personas);
# sí se suben el resumen y los gráficos de analitica/resultados/
*.jsonl
analitica/resultados/eventos.csv

# Registros de errores del teléfono (adb logcat): datos del dispositivo, no se suben
error_*.txt
